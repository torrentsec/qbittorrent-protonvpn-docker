# ──────────────────────────────────────────────────────────────────────
# 🔐 Environment Configuration for qBittorrent + ProtonVPN
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values
# This file contains ALL configuration variables with descriptions
# ──────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────
# 🛡️ ProtonVPN WireGuard Configuration
# ──────────────────────────────────────────────────────────────────────
# Get your WireGuard config from: https://account.protonvpn.com/downloads
# Required: ProtonVPN Plus or higher subscription

WIREGUARD_PRIVATE_KEY=your_private_key_here

# VPN Server Selection
# Examples: "United States", "Netherlands", "Switzerland", "United Kingdom"
SERVER_COUNTRIES=Netherlands

# Optional: Specify city for more precise server selection
# Examples: "Amsterdam", "London", "New York"
SERVER_CITIES=

# VPN Port Forwarding (automatically assigned by ProtonVPN)
# Leave as 0 for automatic assignment
VPN_FORWARDED_PORT=0

# ──────────────────────────────────────────────────────────────────────
# 👤 User & System Configuration
# ──────────────────────────────────────────────────────────────────────
# Find your PUID and PGID by running: id -u and id -g

PUID=1000
PGID=1000

# Timezone - See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: "America/New_York", "Europe/London", "Asia/Tokyo"
TZ=UTC

# ──────────────────────────────────────────────────────────────────────
# 🔒 API Security Configuration
# ──────────────────────────────────────────────────────────────────────
# Generate a secure random API key: openssl rand -hex 32

# Gluetun port sync API key (used by qBittorrent mod)
GSP_GTN_API_KEY=your_random_api_key_here

# ──────────────────────────────────────────────────────────────────────
# 📊 Monitoring & Observability
# ──────────────────────────────────────────────────────────────────────

# Grafana Admin Credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_secure_password

# Log Level: debug, info, warning, error
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────
# 💾 Storage Configuration
# ──────────────────────────────────────────────────────────────────────

# Download paths (relative to project root or absolute paths)
DOWNLOADS_PATH=./downloads
INCOMPLETE_PATH=./incomplete

# ──────────────────────────────────────────────────────────────────────
# 🔄 Optional: Advanced Configuration
# ──────────────────────────────────────────────────────────────────────

# Watchtower update schedule (seconds)
# Default: 86400 (24 hours)
# WATCHTOWER_POLL_INTERVAL=86400

# Container resource limits (uncomment to enable)
# QBITTORRENT_MEMORY_LIMIT=2g
# QBITTORRENT_CPU_LIMIT=2.0

# ──────────────────────────────────────────────────────────────────────
# 📝 Notes
# ──────────────────────────────────────────────────────────────────────
# - Keep this file secure and NEVER commit it to version control
# - The .gitignore file is configured to exclude .env
# - All sensitive values should be generated uniquely
# - After modifying, restart containers: make restart
# ──────────────────────────────────────────────────────────────────────
