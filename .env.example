# ══════════════════════════════════════════════════════════════════════
# 🔐 ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════
#
# This file contains ALL the settings for your qBittorrent + VPN setup.
#
# IMPORTANT - HOW TO USE THIS FILE:
# 1. Copy this file: cp .env.example .env
# 2. Edit the .env file with your actual values
# 3. NEVER share your .env file (it contains secrets!)
# 4. The .env file is gitignored (won't be uploaded to GitHub)
#
# NOTE: Lines starting with # are comments (explanations)
#       Remove the # to uncomment a setting
#
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# 🛡️ PROTONVPN CONFIGURATION
# ──────────────────────────────────────────────────────────────────────
#
# WHERE TO GET THESE VALUES:
# 1. Log in to ProtonVPN: https://account.protonvpn.com
# 2. Go to Downloads > WireGuard configuration
# 3. Download a config file
# 4. Open it with a text editor
# 5. Find the [Interface] section
# 6. Copy the PrivateKey value
#
# REQUIREMENTS:
# - ProtonVPN Plus or Unlimited subscription
#   (Basic/Free plans don't support WireGuard or port forwarding)
#

# Your WireGuard private key (looks like a random string of letters/numbers)
# Example: WIREGUARD_PRIVATE_KEY=xZyW9vU8tS7rQ6pO5nM4lK3jI2hG1fE0dC9bA8=
WIREGUARD_PRIVATE_KEY=your_private_key_here

# ──────────────────────────────────────────────────────────────────────
# 📍 VPN SERVER LOCATION
# ──────────────────────────────────────────────────────────────────────
#
# Choose which country's VPN servers to connect to.
# Affects your IP address location and possibly speed.
#
# TIPS FOR CHOOSING:
# - Closer servers = faster speeds
# - Some countries have better privacy laws
# - Some content is region-locked
#
# POPULAR OPTIONS:
# - Netherlands (good privacy laws, central Europe)
# - Switzerland (excellent privacy laws)
# - United States (good speeds if you're in Americas)
# - United Kingdom (good for Europe)
# - Japan (good for Asia/Pacific)
#
# FORMAT: Use the full country name in quotes
#

# Which country's servers to use
# Examples: "Netherlands", "Switzerland", "United States", "Japan"
SERVER_COUNTRIES=Netherlands

# (OPTIONAL) Specific city within the country
# Leave empty to let ProtonVPN choose automatically
# Examples: "Amsterdam", "Zurich", "New York", "Tokyo"
SERVER_CITIES=

# ──────────────────────────────────────────────────────────────────────
# 🌐 PORT FORWARDING
# ──────────────────────────────────────────────────────────────────────
#
# WHAT IS PORT FORWARDING?
# It allows other torrent users to connect directly to you,
# which GREATLY improves download/upload speeds.
#
# HOW IT WORKS:
# - Set to 0 (zero) to let ProtonVPN assign a port automatically
# - The port changes each time you connect (this is normal)
# - The sync mod automatically updates qBittorrent with the new port
#
# IMPORTANT: Don't change this unless you know what you're doing!
#

# VPN forwarded port (0 = automatic, recommended)
VPN_FORWARDED_PORT=0

# ──────────────────────────────────────────────────────────────────────
# 👤 USER & PERMISSIONS
# ──────────────────────────────────────────────────────────────────────
#
# WHAT ARE THESE?
# These numbers control who "owns" the downloaded files.
# Setting them correctly prevents "permission denied" errors.
#
# HOW TO FIND YOUR VALUES:
# Open a terminal and run these commands:
#   id -u    (this gives you PUID)
#   id -g    (this gives you PGID)
#
# DEFAULTS:
# - 1000 works for most single-user systems
# - macOS users: usually 501
# - Linux users: usually 1000
#

# User ID (run 'id -u' in terminal to find yours)
PUID=1000

# Group ID (run 'id -g' in terminal to find yours)
PGID=1000

# ──────────────────────────────────────────────────────────────────────
# ⏰ TIMEZONE
# ──────────────────────────────────────────────────────────────────────
#
# Sets the time zone for logs and schedules.
# Makes timestamps in logs match your local time.
#
# FIND YOUR TIMEZONE:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Look in the "TZ identifier" column
#
# COMMON EXAMPLES:
# - America/New_York    (US Eastern Time)
# - America/Los_Angeles (US Pacific Time)
# - America/Chicago     (US Central Time)
# - Europe/London       (UK)
# - Europe/Paris        (Central European Time)
# - Asia/Tokyo          (Japan)
# - Australia/Sydney    (Australia)
#

# Your timezone (TZ database format)
TZ=UTC

# ──────────────────────────────────────────────────────────────────────
# 🔒 SECURITY - API KEYS
# ──────────────────────────────────────────────────────────────────────
#
# WHAT IS THIS?
# An API key is like a password that allows the port sync mod
# to communicate between Gluetun and qBittorrent securely.
#
# HOW TO GENERATE A SECURE KEY:
# Run this command in terminal:
#   openssl rand -hex 32
#
# Or use an online generator:
#   https://www.random.org/strings/
#   (Set length to 64, allow A-F and 0-9)
#
# IMPORTANT: Keep this secret! Anyone with this key can control your VPN.
#

# API key for Gluetun-qBittorrent port synchronization
# Generate with: openssl rand -hex 32
GSP_GTN_API_KEY=your_random_api_key_here

# ──────────────────────────────────────────────────────────────────────
# 📊 MONITORING CREDENTIALS
# ──────────────────────────────────────────────────────────────────────
#
# WHAT IS GRAFANA?
# Grafana is the web dashboard where you can see:
# - VPN connection status
# - Download/upload speeds
# - CPU and memory usage
# - Logs from all services
#
# ACCESS: http://localhost:3000
#
# SECURITY NOTE:
# Change these default credentials after first login!
# Anyone who can access your network can access these services.
#

# Grafana admin username
GRAFANA_USER=admin

# Grafana admin password (CHANGE THIS!)
# Use a strong password (mix of letters, numbers, symbols)
GRAFANA_PASSWORD=changeme_secure_password

# ──────────────────────────────────────────────────────────────────────
# 📝 LOGGING LEVEL
# ──────────────────────────────────────────────────────────────────────
#
# HOW MUCH INFORMATION TO LOG:
# - error: Only errors (minimal logging)
# - info:  Normal operations + errors (recommended)
# - debug: Everything including technical details (for troubleshooting)
#
# WHEN TO USE EACH:
# - Use "info" for normal operation
# - Use "debug" when troubleshooting problems
# - Use "error" if logs are too noisy
#

# Logging level: error, info, or debug
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────
# 💾 STORAGE PATHS
# ──────────────────────────────────────────────────────────────────────
#
# WHERE YOUR DOWNLOADS GO:
# - DOWNLOADS_PATH: Finished/completed downloads
# - INCOMPLETE_PATH: Files currently downloading
#
# WHY SEPARATE FOLDERS?
# - Keeps things organized
# - Incomplete folder can be on faster SSD
# - Completed folder can be on larger HDD
# - Media servers can watch only completed folder
#
# PATH FORMATS:
# - Relative: ./downloads (relative to docker-compose.yml location)
# - Absolute: /home/username/torrents (full path from root)
#
# EXAMPLES:
# - ./downloads                    (folder next to docker-compose.yml)
# - /Users/john/Downloads/torrents (macOS absolute path)
# - /home/john/torrents            (Linux absolute path)
# - C:/Users/John/Downloads        (Windows with WSL2)
#

# Where completed downloads are stored
DOWNLOADS_PATH=./downloads

# Where incomplete downloads are temporarily stored
INCOMPLETE_PATH=./incomplete

# ──────────────────────────────────────────────────────────────────────
# 🔧 ADVANCED OPTIONS (Optional)
# ──────────────────────────────────────────────────────────────────────
#
# These settings have good defaults. Only change if you know what you're doing!
#

# How often Watchtower checks for updates (in seconds)
# Default: 86400 (24 hours)
# To disable updates: comment out or set very high number
# WATCHTOWER_POLL_INTERVAL=86400

# Container resource limits (uncomment to enable)
# Prevents qBittorrent from using too much RAM/CPU
# QBITTORRENT_MEMORY_LIMIT=2g     # Maximum 2 GB of RAM
# QBITTORRENT_CPU_LIMIT=2.0       # Maximum 2 CPU cores

# ══════════════════════════════════════════════════════════════════════
# ✅ NEXT STEPS
# ══════════════════════════════════════════════════════════════════════
#
# After filling in the values above:
#
# 1. Save this file as .env (not .env.example)
# 2. Verify your settings: make validate
# 3. Start everything: make up
# 4. Test VPN: make test-vpn
# 5. Access qBittorrent: http://localhost:8080
# 6. Access Grafana: http://localhost:3000
#
# NEED HELP?
# - Documentation: See README.md and docs/ folder
# - Commands: Run 'make help'
# - Troubleshooting: Run 'make logs'
#
