# ──────────────────────────────────────────────────────────────────────
# 🔐 ProtonVPN WireGuard Configuration
# ──────────────────────────────────────────────────────────────────────
# Get your WireGuard private key from ProtonVPN account settings
WIREGUARD_PRIVATE_KEY=your_private_key_here
SERVER_COUNTRIES="United Kingdom"
SERVER_CITIES="London"

# ──────────────────────────────────────────────────────────────────────
# 👤 User & System Settings
# ──────────────────────────────────────────────────────────────────────
# PUID and PGID ensure proper file permissions
# Run `id $USER` in terminal to find your user and group IDs
PUID=1000
PGID=1000
TZ=Europe/London

# ──────────────────────────────────────────────────────────────────────
# 🔒 Gluetun API Authentication
# ──────────────────────────────────────────────────────────────────────
# Secures VPN API access (used by port forwarding sync)
GLUETUN_USER=your_admin_username
GLUETUN_PASS=your_admin_password

# ──────────────────────────────────────────────────────────────────────
# ⚡ qBittorrent Port Forwarding Sync
# ──────────────────────────────────────────────────────────────────────
# API key for automatic port forwarding updates
GSP_GTN_API_KEY=your_random_api_key_here
GSP_QBITTORRENT_PORT=your_forwarded_port_here

# ──────────────────────────────────────────────────────────────────────
# 📡 Arr Stack Configuration
# ──────────────────────────────────────────────────────────────────────
# All Arr apps use the same PUID, PGID, and TZ settings defined above
#
# Default Web UI Ports (accessible via localhost):
# - Sonarr:   http://localhost:8989
# - Radarr:   http://localhost:7878
# - Lidarr:   http://localhost:8686
# - Prowlarr: http://localhost:9696
# - Readarr:  http://localhost:8787
# - Bazarr:   http://localhost:6767
#
# Media directories are organized in ./media/ folder:
# - TV Shows: ./media/tv
# - Movies:   ./media/movies
# - Music:    ./media/music
# - Books:    ./media/books
